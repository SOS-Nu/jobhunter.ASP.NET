{
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_HOST},${DB_PORT};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=True;"
  },
  "Jwt": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "AccessTokenExpirationSeconds": "${JWT_ACCESS_TOKEN_VALIDITY}",
    "RefreshTokenExpirationSeconds": "${JWT_REFRESH_TOKEN_VALIDITY}"
  },
  "Cors": {
    "AllowedOrigins": [
      "${CORS_ALLOWED_ORIGINS}"
    ]
  },
  "FileUpload": {
    "BaseUri": "${UPLOAD_PATH}"
  },
  "Email": {
    "Host": "${MAIL_HOST}",
    "Port": "${MAIL_PORT}",
    "Username": "${MAIL_USERNAME}",
    "Password": "${MAIL_PASSWORD}",
    "From": "${MAIL_USERNAME}"
  },
  "VNPay": {
    "TmnCode": "${VNP_TMN_CODE}",
    "HashSecret": "${VNP_HASH_SECRET}",
    "Url": "${VNP_URL}",
    "ReturnUrl": "${VNP_RETURN_URL}",
    "Version": "2.1.0",
    "Command": "pay"
  },
  "Gemini": {
    "ApiKey": "${GEMINI_API_KEY}",
    "ApiUrl": "${GEMINI_API_URL}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
